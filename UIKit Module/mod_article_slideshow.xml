<changelogs id="mod_article_slideshow" name="JP Article Slideshow" currentVersion="2.7" viewId="mod_article_slideshow" viewName="JP Article Slideshow">
  <changelog date="2026-04-20">
    <element>mod_article_slideshow</element>
    <type>module</type>
    <version>2.7</version>
    <addition>
      <item><![CDATA[Back to Version Recursion prevention for {loadmodule}/{loadposition} is now user-controlled]]></item>
    </addition>
    <change>
      <item><![CDATA[XML-Feld show_featured an Core-mod_articles angeglichen (Werte: show/hide/only, default &quot;show&quot;, validate=&quot;options&quot;, filter=&quot;integer&quot; entfernt)]]></item>
      <item><![CDATA[Helper auf einen einzigen setState(&apos;filter.featured&apos;, ...) Aufruf vereinfacht]]></item>
    </change>
    <fix>
      <item><![CDATA[Parameter „Show Featured Articles&quot; hatte keine Wirkung – behoben]]></item>
    </fix>
    <note>
      <item><![CDATA[Nach dem Update bitte jede Modul-Instanz einmal erneut speichern, damit der neue Optionswert korrekt abgelegt wird]]></item>
      <item><![CDATA[Changelog metadata update (2026-11-06): Release notes are now maintained as XML and published centrally at https://github.com/joomlaplates-de/changelogs. This package includes its release snapshot as changelog.xml.]]></item>
    </note>
  </changelog>
  <changelog date="2026-02-15">
    <element>mod_article_slideshow</element>
    <type>module</type>
    <version>2.6</version>
    <addition>
      <item><![CDATA[Added &quot;Exclude articles with {loadmodule}&quot; toggle (default: No)]]></item>
      <item><![CDATA[Added include/exclude articles feature (modal_article field, like core mod_articles)]]></item>
      <item><![CDATA[Added &quot;Exclude Current Article&quot; toggle]]></item>
    </addition>
    <change>
      <item><![CDATA[Recursion prevention for {loadmodule}/{loadposition} is now user-controlled]]></item>
      <item><![CDATA[Previously articles with {loadmodule} were always excluded (memory overflow protection)]]></item>
      <item><![CDATA[Admin can now decide per module instance whether to filter these articles]]></item>
      <item><![CDATA[Version bump to 2.6]]></item>
    </change>
    <language>
      <item><![CDATA[Added language keys MOD_ARTICLES_FIELD_EXCLUDE_LOADMODULE_LABEL/DESC (en-GB, de-DE)]]></item>
    </language>
  </changelog>
