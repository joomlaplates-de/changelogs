  <changelog>
    <element>mod_uk_timeline</element>
    <type>module</type>
    <version>2.5</version>
    <addition>
      <item><![CDATA[Added services/provider.php for Dependency Injection Container]]></item>
      <item><![CDATA[Added src/Dispatcher/Dispatcher.php (replaces mod_uk_timeline.php)]]></item>
      <item><![CDATA[Added namespace Joomlaplates\Module\UkTimeline]]></item>
      <item><![CDATA[Added README.md]]></item>
      <item><![CDATA[Added blank index.html to all directories]]></item>
    </addition>
    <change>
      <item><![CDATA[Migrated to Joomla 5/6 native module architecture (Namespace, Dispatcher, Service Provider)]]></item>
    </change>
    <fix>
      <item><![CDATA[Fixed Module Class Suffix not being applied in template output]]></item>
      <item><![CDATA[Fixed formsource path (removed leading slash)]]></item>
    </fix>
    <remove>
      <item><![CDATA[Removed legacy entry file mod_uk_timeline.php]]></item>
    </remove>
    <note>
      <item><![CDATA[No longer requires System - Backward Compatibility plugin]]></item>
      <item><![CDATA[Existing module settings are preserved on update]]></item>
    </note>
  </changelog>
