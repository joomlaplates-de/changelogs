  <changelog>
    <element>mod_uk_slide_portfolio</element>
    <type>module</type>
    <version>2.5</version>
    <addition>
      <item><![CDATA[Modern namespace support (Joomlaplates\Module\UkSlidePortfolio)]]></item>
      <item><![CDATA[Dispatcher pattern implementation for Joomla 5/6]]></item>
      <item><![CDATA[Service Provider with Dependency Injection]]></item>
